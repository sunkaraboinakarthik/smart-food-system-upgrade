# ── SmartFood Backend — environment configuration ─────────────────────────────
# Copy this file to `.env` (or export these as real environment variables)
# and fill in real values for production use.

# Flask
SECRET_KEY=change_this_to_a_long_random_string
PORT=5000

# Email (SMTP) — used to send real OTP emails.
# If left blank, OTPs are printed to the server console/log instead (DEV MODE),
# which is perfectly fine for local development and demos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS gateway (Twilio / MSG91 / etc.) — used to send real OTP SMS.
# If left blank, OTPs are printed to the server console/log instead (DEV MODE).
SMS_API_KEY=

# Razorpay — used for real card/UPI/wallet payments.
# If left blank, the payment flow runs in a safe "sandbox" mode that still
# exercises the full create-order -> pay -> verify -> update-order pipeline,
# just without talking to Razorpay's real servers.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
